{
  "type": "module",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=development conc -n client,server \"npm run start:client\" \"npm run start:server\"",
    "build": "NODE_ENV=production npm run build:client && npm run build:server",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "start:client": "vite",
    "start:server": "tsx --watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "rm -rf build/{config,server} && tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "env:encrypt:dev": "dotenvx encrypt -f .env.dev",
    "env:encrypt:prod": "dotenvx encrypt -f .env.prod",
    "env:decrypt:dev": "dotenvx decrypt -f .env.dev",
    "env:decrypt:prod": "dotenvx decrypt -f .env.prod",
    "cli": "tsx src/server/cli.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "@hono/node-server": "2.1.1",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/mysql": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "hono": "4.13.9",
    "node-cron": "4.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "socks": "2.8.10",
    "styled-components": "6.5.3",
    "undici": "8.11.2",
    "webtorrent": "3.0.21",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webtorrent": "3.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-styled-components": "2.3.0",
    "concurrently": "10.0.5",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=11.19.1"
  },
  "overrides": {
    "@sequelize/sqlite3": {
      "sqlite3": "6.0.1"
    }
  }
}
